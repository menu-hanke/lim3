func kspe4(spe) = call Table [
	0,                 1 # default pine when spe=0 (e.g. treeless site)
	~spe'pine,         1
	~spe'spruce,       2
	~spe'silver_birch, 3
	~spe'downy_birch,  4
	~spe'aspen,        3
	~spe'gray_alder,   4
	~spe'black_alder,  4
	~spe'xconiferous,  1
	~spe'xdeciduous,   4
] (spe, out)

func kmty4(mty) = call Table [
	~mty'OMaT, 1
	~mty'OMT,  1
	~mty'MT,   2
	~mty'VT,   3
	~mty'CT,   4
	~mty'ClT,  4
	~mty'ROCK, 4
	~mty'MTN,  4
] (mty, out)

func kalr2(alr) = call Table [
	~alr'mineralsoil, 1
	~alr'peat_spruce, 2
	~alr'peat_pine,   2
	~alr'peat_barren, 2
	~alr'peat_rich,   2
] (alr, out)

model site {

	cc_d0, cc_a0 = call Table ["data/cc.csv"] (kmty4(mty), kspe4(sdom), out, out)

	fth_f1 = call Table ["data/fth.csv"] (kmty4(mty), kspe4(sdom), out)

	th_g0, th_g1 = call Table ["data/thin.csv"] (
		kalr2(alr),
		kmty4(mty),
		kspe4(sdom),
		hdom: interpolate,
		out,
		out
	)

}

func rlv_f(spe) = call Table ["data/rlv.csv"] (kmty4(site.mty), kspe4(spe), out)
