# silvicultural costs (mela: SILVICULTURAL_COSTS)
model site {

	# 2. clearing of regeneration area (€/ha)
	p_cregenarea = 157

	# 3. harrowing and scarification for mineral soils (€/ha)
	p_cscarif = 225

	# 4. ploughing and mounding for peatlands and wet mineral soils (€/ha)
	p_cmound = 328

	# 5. seeds (€/ha)
	p_cseed = 233

	# 6-11. seedlings (€/seedling)
	p_cseedling = call Table [
		2, 1, 0.15
		2, 2, 0.17
		2, 3, 0.23
		3, 1, 0.18
		3, 2, 0.25
		3, 3, 0.35
	] (p_dtag, kspe3(p_dspecies), out)

	# 12. prevention of grass (€/ha)
	p_cruoh = 200

	# 14. pruning (€/stem)
	p_cprune = 1.2

	# 15. fertilization (€/ha)
	p_cfert = 296

	# 16. forest drainage (€/ha)
	p_cdrain = 182

	# 17. ditch cleaning (€/ha)
	p_cditchclean = 65

	# 18. supplementary drainage (€/ha)
	p_csupdrain = 65

	# 19. silvicultural work (€/h)
	p_cwork = 19.45

	# 20. felling work (€/h)
	p_cfell = 24.40

}

# time consumption of silvicultural work (h/ha)
model site {

	# fertilization
	p_tfert = 48/60

	# tending
	p_ttend = 78/60

	# pruninng
	p_tprune = 78/60

	# soil scarification
	p_tscarif = 138/60

	# regeneration
	p_tregen = select(p_dtag=2, 78/60, 138/60)

}

# logging costs (mela: LOGGING_COSTS)
model site {

	# 1. manual felling (€/hour)
	p_chmanu = 24.40

	# 2. mechanized felling (€/hour)
	p_chmoto = 92.0

	# 3. forest haulage (€/hour)
	p_chhaul = 65.0

	# 4. supervision (€/hour)
	p_chadmi = 19.45

	# 5. organization costs (€/m^2)
	p_chorg = 0

	# 6. machine transfer costs (€/stand)
	p_chmachine = 0

}

# energywood logging costs (mela: ENERGYWOOD_LOGGING_COSTS)
model site {

	# 1. mechanized energy wood felling with harvester (€/hour)
	p_ceharv = 95.0

	# 2. manual energy wood felling (€/hour)
	p_cemanu = 24.40

	# 3. mechanized energy wood felling with harwarder (€/hour)
	p_ceharw = 95.0

	# 4. energy wood forest haulage with forwarder (€/hour)
	p_cehfor = 68.0

	# 5. bundler (baling the logging residues) (€/hour)
	p_cebundler = 95.0

	# 6. stump lifting with excavator (€/hour)
	p_ceslift = 68.0

	# 7. terrain chipper (€/hour)
	p_cetchip = 118.0

	# 8. mobile chippers at the road-side landing (€/hour)
	p_cemchip = 173.0

	# 9. fixed stationary crusher (€/m^3)
	p_cestcrush = 2.80

	# 10. compensation of felling logging residues in to piles (€/m^3)
	p_cepilecomp = 0.30

	# 11. organizational costs (€/m^3)
	p_ceorg = 0.0

	# 12. machine transfer costs (€/stand)
	p_cemachine = 0.0

	# 13. long-distance transport with trucks (€/hour)
	p_cetruck = 90.0

	# 14. cost of loading and unloading trucks (€/hour)
	p_cetruckload = 60.0

}

# energywood selection (mela: ENERGYWOOD_LOGGING)
model tree {

	p_ewdmin = 4
	p_ewdmax = 9.99

	p_isew = site.p_bewtag >= 4
		and d >= p_ewdmin
		and any(d <= p_ewdmax, all(s>=6, s!=8), site.p_bewtag>=7)

	p_ewkdmin = 25/1.33
	p_isewk = any(site.p_bewtag=1, site.p_bewtag=3) and d >= p_ewkdmin

	# 27. proportion of logging residue collected as energy wood
	p_ewresp = 0.7

}

model site {

	# 28. proportion of stumps lifted
	p_ewstumpp = 0.85

	# 29. logging residue harvesting method (0-3, see MELA2016 pp. 105-106)
	p_ewresm = 0

}

# natural processes (mela: EVENT_CALL 1)
model site {}

# cuttings (mela: EVENT_CALL 2)
model site {

	# cutting type 1-6 (see MELA2016 p. 130)
	p_btag = 0
	p_bisrenew = any(p_btag=2, p_btag>=5)

	# energywood collection method (x.0-x.9, see MELA2016 pp.130-131)
	p_bewtag = 0

	# 14. logging method (1->moto, 2->manual, 0->cheapest)
	p_bcme = 0

	# 15. is logging performed by a professional?
	p_bprofe = true

}

# regeneration (mela: EVENT_CALL 4)
model site {

	# 1. regeneration method (1->seeding, 2->planting, 3->supplementary planting)
	p_dtag = 2

	# 4. cultivated tree species
	p_dspecies = query.regeneration_species

	# number of reference trees to generate
	p_dcount = 5

	# number of stems to cultivate (default->silvicultural guidelines)
	p_dF = mh_cultivate_f

}
