macro pi 3.14159

macro spe'pine             1
macro spe'spruce           2
macro spe'silver_birch     3
macro spe'downy_birch      4
macro spe'aspen            5
macro spe'gray_alder       6
macro spe'black_alder      7
macro spe'xconiferous      8
macro spe'xdeciduous       9

macro mty'OMaT             1
macro mty'OMT              2
macro mty'MT               3
macro mty'VT               4
macro mty'CT               5
macro mty'ClT              6
macro mty'ROCK             7
macro mty'MTN              8

macro alr'mineralsoil      1
macro alr'peat_spruce      2
macro alr'peat_pine        3
macro alr'peat_barren      4
macro alr'peat_rich        5

macro storie'none          0
macro storie'lower         1
macro storie'upper         2
macro storie'over          3
macro storie'retention     4

macro kk'cultivated        1
macro kk'natural           2
macro kk'infeasible        3

macro var site         _'$expr = $expr
macro var tree         _'$expr = $expr
macro var stratum      _'$expr = $expr
macro var stratum_tree _'$expr = $expr

macro var tree order2'{$x, $y} {
	model site $$ = call Lua["metsi.math":"idxhsort"] (tree.$x, tree.$y, out[N])
}

macro var tree sumL'{$expr where $filter} {
	model site $$ =
		let idx = which(tree._'{$filter}) in
		call Lua["metsi.math":"spsum"] (
			out[N],
			tree.order2'{d, h},
			tree.d,
			tree._'{$expr}[idx],
			idx
		)
}

macro var tree sumL'{$expr where} {
	model site $$ = call Lua["metsi.math":"spsum"] (
		out[N],
		tree.order2'{d, h},
		tree.d,
		tree._'{$expr}
	)
}

macro var site sumT'{$expr where $filter} = sum(tree._'{$expr}[which(tree._'{$filter})])
macro var site sumT'{$expr where} = sum(tree._'{$expr})
macro var site sumT'$expr = sumT'{$expr where}
macro var site sumS'{$expr where $filter} = sum(stratum._'{$expr}[which(stratum._'{$filter})])
macro var site sumS'{$expr where} = sum(stratum._'{$expr})
macro var site sumS'$expr = sumS'{$expr where}

macro var site sum'$expr = sumT'{$expr} + sumS'{$expr}

# is it coniferous/deciduous
func isconif(s) = any(s<=2, s=8)
func isdecid(s) = not isconif(s)

# 1: pine/conifer, 2: spruce, 3: deciduous
func kspe3(s) = call Table [
	0,                 1 # default pine when spe=0 (e.g. treeless site)
	~spe'pine,         1
	~spe'spruce,       2
	~spe'silver_birch, 3
	~spe'downy_birch,  3
	~spe'aspen,        3
	~spe'gray_alder,   3
	~spe'black_alder,  3
	~spe'xconiferous,  1
	~spe'xdeciduous,   3
] (s, out)

# 1: pine/conifer, 2: spruce, 3: silver birch/aspen, 4: downy birch/other deciduous
func kspe4(s) = call Table [
	0,                 1 # default pine when spe=0 (e.g. treeless site)
	~spe'pine,         1
	~spe'spruce,       2
	~spe'silver_birch, 3
	~spe'downy_birch,  4
	~spe'aspen,        3
	~spe'gray_alder,   4
	~spe'black_alder,  4
	~spe'xconiferous,  1
	~spe'xdeciduous,   4
] (s, out)

# 1: OMaT/OMT, 2: MT, 3: VT, 4: ClT or worse
func kmty4(mty) = min(max(1, mty-1), 4)

# 1: mineral soil, 2: peat
func kalr2(alr) = min(alr, 2)
